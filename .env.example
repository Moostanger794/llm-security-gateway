# Optional. Defaults work without this file or any external services.
APP_NAME=AI Security Gateway
LOG_LEVEL=INFO

# External analysis requires BOTH flags plus an explicitly selected model and API key.
# Secrets are read only from this working-directory file / named environment variables.
ENABLE_LLM_ANALYSIS=false
ALLOW_EXTERNAL_LLM=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=0
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=512
